# ============================================================
# LLM API 配置（至少配一个）
# ============================================================
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat                            # 生成用模型
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5        # 本地 Embedding 模型
# HF_ENDPOINT=https://hf-mirror.com                # 可选 HuggingFace 镜像

# ============================================================
# 可选：多 Provider 降级（litellm 支持）
# ============================================================
# OLLAMA_BASE_URL=http://localhost:11434            # 本地 Ollama 降级

# ============================================================
# Rerank 模型
# ============================================================
# 本地模型路径（首次运行自动从 HuggingFace 下载）
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_TIMEOUT_SECONDS=5
STARTUP_PRELOAD_RERANKER=true                       # 低内存启动可设为 false

# RAG 请求可靠性
MAX_CONCURRENT_QUERIES=8
REQUEST_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=1

# Agent 执行预算
AGENT_MAX_ITERATIONS=5
AGENT_MAX_TOOL_CALLS=5
AGENT_MAX_TOKEN_BUDGET=12000
AGENT_TIMEOUT_SECONDS=60
AGENT_PLANNER_TEMPERATURE=0.1
AGENT_PLANNER_MAX_TOKENS=512
AGENT_FINAL_MAX_TOKENS=1024
AGENT_MAX_TOOL_RESULT_LENGTH=1000
AGENT_VERBOSE=true

# ============================================================
# 向量存储
# ============================================================
CHROMA_PERSIST_DIR=./data/chroma

# ============================================================
# 缓存
# ============================================================
CACHE_DB_PATH=./data/cache.db

# ============================================================
# 检索参数
# ============================================================
RRF_K=60                                            # RRF 融合参数
VECTOR_TOP_K=20                                     # 向量检索候选数
BM25_TOP_K=20                                       # BM25 检索候选数
RERANK_TOP_K=10                                     # Rerank 后保留数量

# ============================================================
# Token 预算
# ============================================================
MAX_CONTEXT_TOKENS=4096                             # 上下文窗口总预算
SYSTEM_RESERVE_RATIO=0.30                           # 系统提示词+用户问题预留比例
CONTEXT_BUFFER_RATIO=0.05                           # 防抖动余量

# ============================================================
# Prompt 版本
# ============================================================
PROMPT_VERSION=v1

# ============================================================
# 追踪监控（可选，不配则跳过）
# ============================================================
# LANGFUSE_PUBLIC_KEY=pk-your-key
# LANGFUSE_SECRET_KEY=sk-your-key
# LANGFUSE_HOST=https://cloud.langfuse.com

# ============================================================
# 日志级别
# ============================================================
LOG_LEVEL=INFO

# 单文件上传上限（字节，正整数；默认 20 MiB）
MAX_UPLOAD_BYTES=20971520
