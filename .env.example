# ============================================================
# LLM API 配置（至少配一个）
# ============================================================
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat                            # 生成用模型
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5        # 本地 Embedding 模型
# HF_ENDPOINT=https://hf-mirror.com                # 可选 HuggingFace 镜像

# ============================================================
# 可选：多 Provider 降级（litellm 支持）
# ============================================================
# OLLAMA_BASE_URL=http://localhost:11434            # 本地 Ollama 降级

# ============================================================
# Rerank 模型
# ============================================================
# 本地模型路径（首次运行自动从 HuggingFace 下载）
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_TIMEOUT_SECONDS=5
STARTUP_PRELOAD_RERANKER=true                       # 低内存启动可设为 false

# RAG 请求可靠性
MAX_CONCURRENT_QUERIES=8
REQUEST_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=1

# 索引管理接口认证（生产环境必须设置；仅本机开发可显式免认证）
ADMIN_API_KEY=
ALLOW_UNAUTHENTICATED_ADMIN=false

# Agent 执行预算
AGENT_MAX_ITERATIONS=5
AGENT_MAX_TOOL_CALLS=5
AGENT_MAX_TOKEN_BUDGET=12000
AGENT_TIMEOUT_SECONDS=60
AGENT_TOOL_APPROVAL_TIMEOUT_SECONDS=25
# 精确注册名 JSON 数组；空 allowlist 表示默认允许，denylist 始终优先
AGENT_TOOL_ALLOWLIST=[]
AGENT_TOOL_DENYLIST=[]
# json 为兼容默认；支持 OpenAI-compatible 原生 Tool Calling 的模型可设为 native
AGENT_PLANNER_MODE=json
AGENT_PLANNER_TEMPERATURE=0.1
AGENT_PLANNER_MAX_TOKENS=512
AGENT_FINAL_MAX_TOKENS=1024
AGENT_MAX_TOOL_RESULT_LENGTH=1000
AGENT_VERBOSE=true
TOOL_DEDUP_MAX_SESSIONS=10000

# 可选 MCP Server 列表；留空时不启动 MCP，也不改变原有 Agent 行为
MCP_SERVERS=[]
# 应用启动后会在后台自动连接已启用 Server；连接失败或握手等待不会阻塞核心 HTTP 服务
# MCP_SERVERS=[{"id":"clock","transport":"stdio","command":"python","args":["-m","src.mcp_servers.time_server"],"call_timeout_seconds":30}]
# Streamable HTTP 无认证示例：
# MCP_SERVERS=[{"id":"remote","transport":"streamable_http","url":"https://mcp.example.com/mcp","timeout_seconds":10,"read_timeout_seconds":300,"call_timeout_seconds":30}]
# 可选标准 OAuth（原生客户端仅允许 loopback IP 的 HTTP 回调，其他回调必须 HTTPS；Token 默认仅保存在当前进程内存）：
# MCP_SERVERS=[{"id":"remote","transport":"streamable_http","url":"https://mcp.example.com/mcp","oauth":{"redirect_uri":"http://127.0.0.1:8000/agent/oauth/remote/callback","client_name":"ragrag local client","scope":"mcp:tools offline_access"}}]

# ============================================================
# 向量存储
# ============================================================
CHROMA_PERSIST_DIR=./data/chroma

# ============================================================
# 缓存
# ============================================================
CACHE_DB_PATH=./data/cache.db
CACHE_MAX_ENTRIES=10000

# ============================================================
# 检索参数
# ============================================================
RRF_K=60                                            # RRF 融合参数
VECTOR_TOP_K=20                                     # 向量检索候选数
BM25_TOP_K=20                                       # BM25 检索候选数
RERANK_TOP_K=10                                     # Rerank 后保留数量
# 仅使用人工核验 final 报告生成的阈值；三项必须同时配置
# ABSTENTION_THRESHOLDS={"hybrid+rerank":0.42}
# ABSTENTION_CALIBRATION_ID=sha256:replace-with-calibration-id
# ABSTENTION_CALIBRATION_MODELS={"embedding":"BAAI/bge-base-en-v1.5","reranker":"BAAI/bge-reranker-base"}

# ============================================================
# Token 预算
# ============================================================
MAX_CONTEXT_TOKENS=4096                             # 上下文窗口总预算
SYSTEM_RESERVE_RATIO=0.30                           # 系统提示词+用户问题预留比例
CONTEXT_BUFFER_RATIO=0.05                           # 防抖动余量

# ============================================================
# Prompt 版本
# ============================================================
PROMPT_VERSION=v1

# ============================================================
# 追踪监控（可选，不配则跳过）
# ============================================================
# LANGFUSE_PUBLIC_KEY=pk-your-key
# LANGFUSE_SECRET_KEY=sk-your-key
# LANGFUSE_HOST=https://cloud.langfuse.com

# ============================================================
# 日志级别
# ============================================================
LOG_LEVEL=INFO
AGENT_LOG_MAX_BYTES=10485760
AGENT_LOG_BACKUP_COUNT=5
AGENT_LOG_RETENTION_SECONDS=604800

# 单文件上传上限（字节，正整数；默认 20 MiB）
MAX_UPLOAD_BYTES=20971520
